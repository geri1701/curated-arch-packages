pkgname=mediatek-mt7927-dkms
pkgver=2.14
pkgrel=1
pkgdesc='DKMS Wi-Fi and optional Bluetooth modules for MediaTek MT7927 Filogic 380'
arch=('x86_64')
url='https://github.com/jetm/mediatek-mt7927-dkms'
license=('GPL-2.0-only AND LicenseRef-MediaTek-Firmware')
depends=('dkms' 'linux-firmware-mediatek>=20260810')
makedepends=('curl' 'python')
provides=('mediatek-mt6639-bt-dkms' 'mediatek-mt7925-wifi-dkms')
conflicts=('btusb-mt7925-dkms' 'btusb-mt7927-dkms')
install=mediatek-mt7927-dkms.install

_upstream_tag=v2.14-6
_upstream_commit=05614ebc5dec99daef52098ab25b18d53473a936
_source_dir="$pkgname-$_upstream_commit"
_kernel_version=7.2
_driver_filename=DRV_WiFi_MTK_MT7925_MT7927_TP_W11_64_V5603998_20250709R.zip
_driver_sha256=b377fffa28208bb1671a0eb219c84c62fba4cd6f92161b74e4b0909476307cc8

source=(
  "$pkgname-$_upstream_commit.tar.gz::$url/archive/$_upstream_commit.tar.gz"
  "linux-$_kernel_version.tar.xz::https://cdn.kernel.org/pub/linux/kernel/v${_kernel_version%%.*}.x/linux-$_kernel_version.tar.xz"
  'FIRMWARE-NOTICE'
)
sha256sums=(
  '8fdc1fb3a7927246da496b5216f460b4ac7cd1818128637bd70d667073fdee3e'
  'f9fef3d14c0df53819026f4be74459835c2a0b0dcbf5b5bbd9ea19f0829402b3'
  'd1506a3f72e62b4d1835e278877dd2f6225c19483887d7d002b811abfcca35c3'
)

prepare() {
  local cache_dir=${SRCDEST:-$srcdir}
  local driver_zip="$cache_dir/$_driver_filename"

  if [[ ! -f $driver_zip ]]; then
    DRIVER_FILENAME=$_driver_filename \
      "$srcdir/$_source_dir/download-driver.sh" "$cache_dir"
  fi

  echo "$_driver_sha256  $driver_zip" | sha256sum -c -
}

build() {
  local cache_dir=${SRCDEST:-$srcdir}

  make -C "$srcdir/$_source_dir" sources \
    MT76_KVER=$_kernel_version \
    KERNEL_TARBALL="$srcdir/linux-$_kernel_version.tar.xz" \
    DRIVER_ZIP="$cache_dir/$_driver_filename" \
    SRCDIR="$srcdir/_build"
}

package() {
  local cache_dir=${SRCDEST:-$srcdir}
  local dkms_dir="$pkgdir/usr/src/mediatek-mt7927-$pkgver"

  make -C "$srcdir/$_source_dir" install \
    MT76_KVER=$_kernel_version \
    KERNEL_TARBALL="$srcdir/linux-$_kernel_version.tar.xz" \
    DRIVER_ZIP="$cache_dir/$_driver_filename" \
    SRCDIR="$srcdir/_build" \
    DESTDIR="$pkgdir" \
    VERSION=$pkgver

  # MT7921 serves MT7902, not MT7927, and is already native on supported kernels.
  grep -Fqx 'obj-m += mt7921/' "$dkms_dir/mt76/Kbuild"
  grep -Fq 'BUILT_MODULE_NAME[$_i]="mt7921-common"' "$dkms_dir/dkms.conf"
  grep -Fq 'BUILT_MODULE_NAME[$_i]="mt7921e"' "$dkms_dir/dkms.conf"
  sed -i '/^obj-m += mt7921\/$/d' "$dkms_dir/mt76/Kbuild"
  sed -i \
    -e '/^BUILT_MODULE_NAME\[\$_i\]="mt7921-common"$/,+3d' \
    -e '/^BUILT_MODULE_NAME\[\$_i\]="mt7921e"$/,+3d' \
    "$dkms_dir/dkms.conf"
  rm -rf "$dkms_dir/mt76/mt7921"

  rm "$dkms_dir/extract_firmware.py"
  install -Dm644 "$srcdir/FIRMWARE-NOTICE" \
    "$pkgdir/usr/share/licenses/$pkgname/FIRMWARE-NOTICE"
}
