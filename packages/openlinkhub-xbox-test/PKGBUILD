# Maintainer: Gerhard Schwanzer <geri@sdf.org>

pkgname=openlinkhub-xbox-test
_pkgname=openlinkhub
_commit=d8bd2303689dd0272cfd4be2a0f11089a194fe86
pkgver=0.9.1.r7.gd8bd2303
pkgrel=1
pkgdesc='Experimental Corsair VOID MAX WIRELESS V2 support via Xbox receiver'
arch=('x86_64')
url='https://github.com/geri1701/OpenLinkHub/tree/test-void-max-wireless-xbox'
license=('GPL-3.0-or-later')
depends=(
  'i2c-tools'
  'libpipewire'
  'systemd'
)
makedepends=('go>=1.25.0')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
backup=('etc/udev/rules.d/99-openlinkhub.rules')
options=('!debug')
install="$pkgname.install"
source=(
  "$_pkgname-$_commit.tar.gz::https://github.com/geri1701/OpenLinkHub/archive/$_commit.tar.gz"
  "$pkgname.install"
  'openlinkhub.service'
  'openlinkhub.sysusers'
  'openlinkhub.tmpfiles'
  'README.md'
)
sha256sums=(
  'de092b87b606a3e6130ee234d6fefbd31f4ae79ac68dfdee3cd6f525371cd38e'
  'c2e042a978b5cb4f12bd68724299259efdf8e9b44af4cf907302dce9795101c6'
  'b8ce151d883861cb98b68f0f08191027f462a674317fe8ed9891f9ba2d27da81'
  '325fa3c6ab4222ee77dcfa57f89360172f784ebc7f1b731c7d43d2591daaeb47'
  '7648a2022cad796563dfd267547664705687be03e3079c19c89bb529f7369f59'
  'c6228d4651eb96322ec935b3ab0a2bad5c2d5e6d6c37e6c85e9afe5961b3b3ea'
)

build() {
  cd "OpenLinkHub-$_commit"

  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export CGO_CFLAGS_ALLOW='-fno-strict-overflow'

  go build \
    -buildmode=pie \
    -trimpath \
    -ldflags "-linkmode=external -X OpenLinkHub/src/version.Version=$pkgver" \
    .
}

check() {
  cd "OpenLinkHub-$_commit"

  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export CGO_CFLAGS_ALLOW='-fno-strict-overflow'

  go test \
    ./src/devices \
    ./src/devices/voidV2W \
    ./src/devices/voidV2dongle
}

package() {
  local source_dir="OpenLinkHub-$_commit"

  install -Dm644 openlinkhub.service \
    "$pkgdir/usr/lib/systemd/system/openlinkhub.service"
  install -Dm644 openlinkhub.sysusers \
    "$pkgdir/usr/lib/sysusers.d/openlinkhub.conf"
  install -Dm644 openlinkhub.tmpfiles \
    "$pkgdir/usr/lib/tmpfiles.d/openlinkhub.conf"

  local data_dir
  for data_dir in api database static web; do
    install -d -m 0755 "$pkgdir/var/lib/openlinkhub/$data_dir"
    cp -a "$source_dir/$data_dir/." \
      "$pkgdir/var/lib/openlinkhub/$data_dir/"
  done

  install -Dm644 "$source_dir/99-openlinkhub.rules" \
    "$pkgdir/etc/udev/rules.d/99-openlinkhub.rules"
  install -Dm755 "$source_dir/OpenLinkHub" \
    "$pkgdir/usr/bin/openlinkhub"
  install -Dm644 "$source_dir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
